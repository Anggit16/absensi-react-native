{
  "expo": {
    "name": "AbsensiPro",
    "slug": "absensipro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "absensipro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absensipro.demo"
    },
    "android": {
      "package": "com.absensipro.demo",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AbsensiPro memerlukan lokasi Anda untuk memvalidasi radius kantor saat absen masuk/pulang."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AbsensiPro hanya memakai kamera untuk selfie absensi; galeri tidak dipakai.",
          "cameraPermission": "AbsensiPro memerlukan kamera depan untuk selfie absensi.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
